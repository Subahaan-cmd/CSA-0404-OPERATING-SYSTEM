# /etc/systemd/system/portal.service
[Unit]
Description=University result portal (gunicorn)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=portal
Group=portal
WorkingDirectory=/opt/portal
EnvironmentFile=/etc/portal/portal.env
ExecStart=/opt/portal/venv/bin/gunicorn --workers 4 --bind 127.0.0.1:8000 app:app
Restart=on-failure
RestartSec=2
MemoryMax=1G
CPUQuota=200%
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/portal /var/log/portal
PrivateTmp=true

[Install]
WantedBy=multi-user.target
